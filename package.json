{
  "name": "jdex-manager",
  "version": "0.2.0",
  "description": "Obsidian plugin: create and audit Johnny.Decimal IDs from your JDex.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:hebra": "node scripts/build-hebra.mjs",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1",
    "check": "npm run lint && npm run build && npm run build:hebra && npm run test"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "esbuild": "0.17.3",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.2.9",
    "happy-dom": "^20.14.5",
    "hebra-plugin-api": "github:fodaveg/hebra-plugin-api#v1.0.0",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.35.1",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "obsidian": {
      "@codemirror/state": "$@codemirror/state",
      "@codemirror/view": "$@codemirror/view"
    }
  }
}
