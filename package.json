{
  "name": "jdex-manager",
  "version": "0.2.0",
  "description": "Obsidian plugin: create and audit Johnny.Decimal IDs from your JDex.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "esbuild": "0.17.3",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.2.9",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.35.1",
    "vitest": "^2.1.9"
  }
}
