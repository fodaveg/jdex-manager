{
  "name": "jdex-manager",
  "version": "0.6.1",
  "description": "Obsidian plugin: create and audit Johnny.Decimal IDs from your JDex.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "release:sign-publish": "node scripts/sign-publish.mjs",
    "check:min-app": "node scripts/check-min-app-version.mjs",
    "audit:bundled": "node scripts/audit-bundled.mjs",
    "build:hebra": "node scripts/build-hebra.mjs",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1",
    "test:coverage": "vitest run --maxWorkers=1 --coverage",
    "check": "npm run lint && npm run check:min-app && npm run build && npm run build:hebra && npm run test:coverage"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "0.28.2",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.2.9",
    "happy-dom": "^20.14.5",
    "hebra-plugin-api": "github:fodaveg/hebra-plugin-api#v2.1.0",
    "obsidian": "~1.14.4",
    "tslib": "2.4.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "obsidian": {
      "@codemirror/state": "^6.7.1",
      "@codemirror/view": "^6.43.9"
    }
  }
}
